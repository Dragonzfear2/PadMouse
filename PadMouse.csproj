<Project Sdk="Microsoft.NET.Sdk">
  <!-- For Visual Studio / Rider users. The official build is build.bat, which needs nothing installed. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>5</LangVersion>
    <AssemblyName>PadMouse</AssemblyName>
    <RootNamespace>PadMouse</RootNamespace>
    <ApplicationIcon>src\app.ico</ApplicationIcon>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="lib\SDL2.dll" LogicalName="SDL2.dll" />
  </ItemGroup>
</Project>
